+	e.f.plug("0xc1ae0001")
+	p := e.driver(t)
+	noErr(t, prepare(t, p, withConfig(poolClaim("u1", "c1", "shared0", sharedData), resourceapi.AllocationConfigSourceClaim, nil, fileConfig)).Err)
+	mp := e.files.mountpoint("dax0.0")
+	wantExports(t, x, "start dax0.0 /dev/dax0.0 268435456 "+mp)
+
+	// a restart: new exports (the old mount is stale), the claim's
+	// export is started again
+	x2 := newFakeExporter()
+	x2.stale[mp] = 1
+	e.files = newFileExports(filepath.Join(filepath.Dir(e.stateFile), fileExportsDirName), x2)
+	_ = os.RemoveAll(e.cdiDir)
+	e.driver(t)
+	wantExports(t, x2, "detach "+mp+" 1", "start dax0.0 /dev/dax0.0 268435456 "+mp)
+	e.wantCDIDevice(t, "claim-u1-0", fileEnv("u1"))
+
+	// the dax device is gone while the driver is down: no file
+	_ = os.RemoveAll(e.f.p(daxPath))
+	x3 := e.withFiles(t)
+	_ = os.RemoveAll(e.cdiDir)
+	p3 := e.driver(t)
+	wantExports(t, x3, "detach "+mp+" 0")
+	cd := e.wantCDIDevice(t, "claim-u1-0", []string{"CXL_C1AE0001_MODE=file", "CXL_C1AE0001_READONLY=1",
+		"CXL_C1AE0001_SERIAL=0xc1ae0001", "CXL_C1AE0001_SHARED=1", "CXL_C1AE0001_SIZE=268435456", "CXL_CLAIM_u1=1"})
+	if len(cd.ContainerEdits.Mounts) != 0 {
+		t.Fatalf("mount of a device without an export: %+v", cd.ContainerEdits.Mounts)
+	}
+	if p3.prepared["u1"].Devices[0].Export != "" {
+		t.Fatal("export of a gone device recorded")
+	}
+	noErr(t, unprepare(t, p3, "u1"))
+	e.wantClean(t, p3)
+}
