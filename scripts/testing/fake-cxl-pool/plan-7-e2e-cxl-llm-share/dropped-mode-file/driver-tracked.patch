+
+// fileLeaseEnv is a leaseFdEnv whose pool driver exports files, with a
+// fake file of the export that records how often it is opened.
+type fileLeaseEnv struct {
+	*leaseFdEnv
+	file  string // the file of the export of dax0.0
+	files []string
+}
+
+func newFileLeaseEnv(t *testing.T) *fileLeaseEnv {
+	e := &fileLeaseEnv{leaseFdEnv: newLeaseFdEnv(t, "0xc1ae0001")}
+	e.pe.withFiles(t)
+	e.p.files = e.pe.files
+	e.file = exportFile(e.pe.files.mountpoint("dax0.0"))
+	fake := filepath.Join(e.dir, "fake-file")
+	noErr(t, os.WriteFile(fake, []byte("TAG"), 0o600))
+	e.b.openFile = func(path string) (*os.File, error) {
+		e.mu.Lock()
+		e.files = append(e.files, path)
+		e.mu.Unlock()
+		return os.Open(fake)
+	}
+	return e
+}
+
+// fileEnv returns the env of the file lease.
+func (e *fileLeaseEnv) fileEnv() map[string]string {
+	return map[string]string{"CXL_C1AE0001_PATH": e.file, "CXL_C1AE0001_MODE": "file", "CXL_C1AE0001_READONLY": "1",
+		"CXL_C1AE0001_SERIAL": "0xc1ae0001", "CXL_C1AE0001_SHARED": "1", "CXL_C1AE0001_SIZE": "268435456"}
+}
+
+// wantFileFd checks a Ready file lease response that came with the fd of
+// the fake file, and closes the fd.
+func (e *fileLeaseEnv) wantFileFd(resp api.Response, fd int) {
+	e.t.Helper()
+	wantResponse(e.t, resp, api.Response{State: api.StateReady, Source: "pool", Mode: "file", Shared: true, ReadOnly: true, Size: 268435456,
+		Serial: "0xc1ae0001", Path: e.file, Env: e.fileEnv()})
+	if fd < 0 {
+		e.t.Fatal("no fd")
+	}
+	f := os.NewFile(uintptr(fd), "file")
+	defer f.Close()
+	buf := make([]byte, 3)
+	if _, err := f.ReadAt(buf, 0); err != nil || string(buf) != "TAG" {
+		e.t.Fatalf("read %q through the fd: %v", buf, err)
+	}
+}
+
+// TestBrokerSharedFileLease leases one host of a shared device in mode
+// file: the companion claim asks for mode file read-only, the pool driver
+// exports the device, and the fd that comes with the response is of the
+// file of the export, opened for reading.
+func TestBrokerSharedFileLease(t *testing.T) {
+	e := newFileLeaseEnv(t)
+	claim, resp, fd := e.prepareLease(api.Request{Op: "request", Serial: "0xc1ae0001", Shared: true, Mode: "file", ReadOnly: true}, "shared0", sharedData)
+	if ex := claim.Spec.Devices.Requests[0].Exactly; ex == nil || ex.DeviceClassName != device.ClassPoolShared || ex.Capacity != nil {
+		t.Fatalf("shared request %+v", claim.Spec.Devices.Requests[0])
+	}
+	if dc := deviceConfigOf(t, claim, device.PoolDriverName); dc == nil || dc.Mode != api.ModeFile || !dc.ReadOnly {
+		t.Fatalf("companion DeviceConfig %+v", dc)
+	}
+	e.wantFileFd(resp, fd)
+	if got := api.ExecEnv(resp.Env, resp.Lease, 3); !slices.Contains(got, "CXL_C1AE0001_FD=3") || slices.Contains(got, "CXL_C1AE0001_PATH="+e.file) {
+		t.Fatalf("exec env %v", got)
+	}
+	// the fd again, and the env without it
+	resp, fd = e.call(api.Request{Op: "fd", Lease: "000000a1", Wait: "1s"})
+	e.wantFileFd(resp, fd)
+	resp, fd = e.call(api.Request{Op: "env", Lease: "000000a1"})
+	if fd >= 0 || !reflect.DeepEqual(resp.Env, e.fileEnv()) {
+		t.Fatalf("env %+v fd %d", resp, fd)
+	}
+	e.mu.Lock()
+	files := slices.Clone(e.files)
+	e.mu.Unlock()
+	if !slices.Equal(files, []string{e.file, e.file}) || len(e.opened()) != 0 {
+		t.Fatalf("opened files %v, dax devices %v", files, e.opened())
+	}
+	if calls := e.lender.callLog(); strings.Contains(calls, "lend") {
+		t.Fatalf("file memory lent as a node:\n%s", calls)
+	}
+	e.wantReleaseAll(1)
+}
