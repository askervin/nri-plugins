+// TestPrepareLocalFileErrors checks the mode file rules of cxl.generic and
+// the rollback of a failed export.
+func TestPrepareLocalFileErrors(t *testing.T) {
+	e := newLocalTestState(t)
+	ctx := context.Background()
+	// no file exports: the slice is released again
+	wantErr(t, e.Prepare(ctx, localClaim("u1", localBlockSize, localFileConfig)), errNoFileExports.Error())
+	if e.inUse() || len(e.Prepared) != 0 {
+		t.Fatal("not rolled back")
+	}
+	x := e.withFiles(t)
+	wantErr(t, e.Prepare(ctx, localClaim("u1", localBlockSize, `{"apiVersion":"cxl.generic/v1alpha1","kind":"DeviceConfig","mode":"file"}`)),
+		"DeviceConfig: mode file needs readOnly: true")
+	x.startErr = errors.New("mounting: no /dev/fuse")
+	wantErr(t, e.Prepare(ctx, localClaim("u1", localBlockSize, localFileConfig)), "file export of dax0.0: mounting: no /dev/fuse")
+	if e.inUse() || len(e.Prepared) != 0 {
+		t.Fatal("not rolled back")
+	}
+	// a later device fails: the export is stopped, the slice released
+	x.startErr = nil
+	claim := localClaim("u1", localBlockSize, localFileConfig)
+	claim.Status.Allocation.Devices.Results = append(claim.Status.Allocation.Devices.Results,
+		resourcev1.DeviceRequestAllocationResult{Request: "other", Driver: device.DriverName, Pool: testNode, Device: "missing"})
+	x.logged()
+	wantErr(t, e.Prepare(ctx, claim), "could not find allocatable device missing")
+	wantExports(t, x, fmt.Sprintf("start dax0.0 /dev/dax0.0 %d %s", localBlockSize, e.files.mountpoint("dax0.0")), "stop dax0.0")
+	if e.inUse() {
+		t.Fatal("not rolled back")
+	}
+}
