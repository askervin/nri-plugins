+// TestPrepareLocalFile prepares a slice of a local memdev in mode file: a
+// zeroed dax slice with its export, a CDI mount and PATH; the Unprepare
+// stops the export before the slice is deleted, and fails while the export
+// is busy.
+func TestPrepareLocalFile(t *testing.T) {
+	e := newLocalTestState(t)
+	x := e.withFiles(t)
+	ctx := context.Background()
+	noErr(t, e.Prepare(ctx, localClaim("u1", localBlockSize, localFileConfig)))
+	mp := e.files.mountpoint("dax0.0")
+	wantExports(t, x, fmt.Sprintf("start dax0.0 /dev/dax0.0 %d %s", localBlockSize, mp))
+	e.wantCDIDevices(t, "u1", "generic/cxl=claim-u1-0")
+	e.wantDeviceInfo(t, "u1", PreparedDeviceInfo{
+		RequestName: "mem", DeviceName: localDeviceName, DeviceType: device.DeviceTypeMemdev, Mode: api.ModeFile,
+		SysfsPath: e.f.p("bus/cxl/devices/region0"), NodeAffinities: []int{0},
+		TotalBytes: localBlockSize, ConsumedBytes: localBlockSize, Serial: "0xc100e2e1",
+		DaxDevice: "/dev/dax0.0", DaxMajor: 252, DaxMinor: 0, ReadOnly: true, Export: mp,
+	})
+	// a dax slice, zeroed like every dax slice
+	e.f.wantDax(t, "dax0.0", localBlockSize, "device_dax")
+	if got := strings.Join(e.f.zeroed, ","); got != fmt.Sprintf("252:0 %d %d", localBlockSize, 2*mib) {
+		t.Fatalf("zeroed %s", got)
+	}
+	e.wantCDIDevice(t, "claim-u1-0",
+		[]string{"CXL_C100E2E1_MODE=file", "CXL_C100E2E1_PATH=/run/cxl-files/C100E2E1/data", "CXL_C100E2E1_READONLY=1",
+			"CXL_C100E2E1_SERIAL=0xc100e2e1", "CXL_C100E2E1_SHARED=0", "CXL_C100E2E1_SIZE=134217728", "CXL_CLAIM_u1=1"}, nil)
+	if cd := cdiDeviceByName(e.cdiSpec(t), "claim-u1-0"); !reflect.DeepEqual(cd.ContainerEdits.Mounts, []*cdiSpecs.Mount{fileCDIMount(mp, "C100E2E1")}) {
+		t.Fatalf("mounts %+v", cd.ContainerEdits.Mounts)
+	}
+
+	// busy: the Unprepare fails, the slice stays
+	x.stopErr = fmt.Errorf("unmounting %s: %w", mp, unix.EBUSY)
+	wantErr(t, e.Unprepare(ctx, "u1"), "claim demo/claim-u1: file export of dax0.0: unmounting "+mp+": device or resource busy")
+	if !e.inUse() || e.preparedClaims["u1"] == nil {
+		t.Fatal("a busy unprepare released the slice")
+	}
+	noErr(t, e.Unprepare(ctx, "u1"))
+	wantExports(t, x, "stop dax0.0")
+	if e.cdiSpec(t) != nil || e.inUse() {
+		t.Fatalf("after the unprepare: in use %v", e.inUse())
+	}
+	e.f.wantRegionReleased(t, "region0")
+}
