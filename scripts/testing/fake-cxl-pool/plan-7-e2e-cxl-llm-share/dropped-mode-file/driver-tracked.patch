+func TestRunExecFile(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "data")
+	if err := os.WriteFile(file, []byte("GGUF-123"), 0o444); err != nil {
+		t.Fatal(err)
+	}
+	path := "/var/lib/kubelet/plugins/cxl.generic/files/dax0.0/data"
+	resp := `{"lease":"000000a8","state":"Ready","source":"pool","mode":"file","shared":true,"readOnly":true,"size":268435456,"serial":"0xc1ae0001","path":"` + path + `",` +
+		`"env":{"CXL_C1AE0001_PATH":"` + path + `","CXL_C1AE0001_MODE":"file","CXL_C1AE0001_READONLY":"1","CXL_C1AE0001_SERIAL":"0xc1ae0001","CXL_C1AE0001_SHARED":"1","CXL_C1AE0001_SIZE":"268435456"}}`
+	sock, reqs := fakeServer(t, resp, file)
+	t.Setenv(api.SocketEnv, sock)
+	var out, errb bytes.Buffer
+	script := `echo "$CXL_C1AE0001_FD $CXL_C1AE0001_MODE ${CXL_C1AE0001_PATH-none} $CXL_C1AE0001_READONLY"; head -c 8 <&3; exit 5`
+	code := run([]string{"request", "--serial", "0xc1ae0001", "--shared", "--mode", "file", "--read-only", "--exec", "/bin/sh", "-c", script}, &out, &errb)
+	if code != 5 {
+		t.Fatalf("exit %d (stderr %s)", code, errb.String())
+	}
+	if r := <-reqs; r != (api.Request{Op: "request", Serial: "0xc1ae0001", Shared: true, Mode: "file", ReadOnly: true}) {
+		t.Fatalf("request %+v", r)
+	}
+	if want := "3 file none 1\nGGUF-123"; out.String() != want {
+		t.Fatalf("output %q, want %q", out.String(), want)
+	}
+	// env: the path on the node, no fd
+	out.Reset()
+	if code := run([]string{"env", "--lease", "000000a8"}, &out, &errb); code != exitOK || !strings.Contains(out.String(), "CXL_C1AE0001_PATH="+path+"\n") {
+		t.Fatalf("env: exit %d output %q", code, out.String())
+	}
+}
